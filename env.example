# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
# Load it before launching uvicorn, e.g.:
#   set -a && source .env && set +a
#   uvicorn server:app --host 0.0.0.0 --port 8080
# Never commit the real .env -- it holds the Core master key.

# --- Where SuperTokens Core lives -------------------------------------------
# Running this server INSIDE Docker on supertokens-network:
#   SUPERTOKENS_BASE=http://supertokens:3567      (the Core container name)
# Running this server on your host (Mac) for local testing:
#   SUPERTOKENS_BASE=http://localhost:3567        (Core is published on -p 3567:3567)
# Do NOT point this at the public https://sso... URL -- Core must stay private.
SUPERTOKENS_BASE=http://localhost:3567

# --- Core API key (REQUIRED) ------------------------------------------------
# This is the API_KEYS value you passed to the Core container. It is the
# server-to-Core secret -- it lives ONLY here, never in the Swagger Authorize
# boxes and never sent by clients. If this is empty the server logs a warning
# and every Core request fails with "Invalid API key".
# NOTE: the key used during development has been shared in plaintext -- rotate
# it (restart Core with a fresh API_KEYS) and put the new value here.
SUPERTOKENS_API_KEY=2b6cbbeb70b1ae499c1ceb1cf43d165db98a637de9dd44f83804f3523a2cbad7

# --- CDI version ------------------------------------------------------------
# The Core Driver Interface version the server speaks. The tutorial used 4.0,
# but your image is the 7.0 build, which may only accept a newer CDI. Confirm
# with:  curl http://localhost:3567/apiversion -H "api-key: <your key>"
# and set this to a value the response lists. A mismatch makes requests fail
# in confusing ways.
CDI_VERSION=4.0

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins. "*" is convenient for local
# dev; for production set it to your real frontend origin(s), e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# --- PY-SERVER -----------------------------------------------------------------
PYHOST=0.0.0.0
PYPORT=13245

# --- SUPER TOKEN -----------------------------------------------------------------
SUPER_TOKEN_HOST=localhost
SUPER_TOKEN_PORT=3567